    "Sync…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza…"
          }
        }
      }
    },
    "The folder stays untouched in every location. Choose one to see how much it holds.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella resta intatta in ogni posizione. Scegline una per vedere quanto occupa."
          }
        }
      }
    },
    "The new name is applied in every folder that holds this file.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nuovo nome viene applicato in ogni cartella che contiene questo file."
          }
        }
      }
    },
    "The primary folder keeps the original name when two different files share a name.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella primaria mantiene il nome originale quando due file diversi hanno lo stesso nome."
          }
        }
      }
    },
    "These files have different content. I understand they are not copies of the main file.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi file hanno contenuto diverso. Capisco che non sono copie del file principale."
          }
        }
      }
    },
    "They are removed from every folder that still has them. You can restore them from the Trash.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono rimossi da ogni cartella che li ha ancora. Puoi ripristinarli dal Cestino."
          }
        }
      }
    },
    "This folder is empty.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella è vuota."

{
  "sourceLanguage": "en",
  "strings": {
    "%@ ": {
      "shouldTranslate": false
    },
    "%@ cannot be read. Check its permissions.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non può essere letta. Controlla i permessi."
          }
        }
      }
    },
    "%@ is empty but used to contain files. Open GT Sync to decide.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è vuota ma conteneva dei file. Apri GT Sync per decidere."
          }
        }
      }
    },
    "%@ is empty, but it used to contain files. If its disk is not mounted, stop here. If it is a new disk, you can continue: GT Sync will copy your files into it, and nothing is deleted.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è vuota, ma in passato conteneva dei file. Se il disco non è montato, fermati qui. Se è un disco nuovo, puoi continuare: GT Sync ci copierà i tuoi file e non verrà cancellato nulla."
          }
        }
      }
    },
    "%@ is not connected.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è collegato."
          }
        }
      }
    },
    "%@ is not connected. Sync is off and nothing will be changed.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è collegato. La sincronizzazione è disattivata e non verrà modificato nulla."
          }
        }
      }
    },
    "%@ is now on a different disk than before.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ora si trova su un disco diverso da prima."
          }
        }
      }
    },

    "GT Sync": {
      "shouldTranslate": false
    },
    "GT Sync keeps two or more folders merged, on the same disk or on different disks. Nothing is ever overwritten.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GT Sync mantiene unite due o più cartelle, sullo stesso disco o su dischi diversi. Nulla viene mai sovrascritto."
          }
        }
      }
    },
    "General": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Generale"
          }
        }
      }
    },
    "Held by copies that have the same content as a main file. You decide what to remove.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Occupato da copie con lo stesso contenuto di un file principale. Sei tu a decidere cosa rimuovere."
          }
        }
      }
    },

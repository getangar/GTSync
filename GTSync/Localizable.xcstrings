    },
    "Automatic runs only add, copy and rename. Deletions always wait for your decision in Review, and a folder that is missing or suspiciously empty stops the run.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le esecuzioni automatiche aggiungono, copiano e rinominano soltanto. Le cancellazioni aspettano sempre la tua decisione in Revisione, e una cartella mancante o sospettosamente vuota ferma l'esecuzione."
          }
        }
      }
    },
    "Automatic sync": {
      "localizations": {
